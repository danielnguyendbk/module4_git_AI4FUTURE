generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DocumentStatus {
  UPLOADING
  READY
  FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(120)
  role         UserRole   @default(USER)
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  documents    Document[]

  @@map("users")
}

model Document {
  id             String         @id @default(uuid()) @db.Uuid
  ownerId        String         @map("owner_id") @db.Uuid
  originalName   String         @map("original_name") @db.VarChar(255)
  storageKey     String         @unique @map("storage_key") @db.VarChar(512)
  mimeType       String         @map("mime_type") @db.VarChar(255)
  sizeBytes      BigInt         @map("size_bytes")
  checksumSha256 String?        @map("checksum_sha256") @db.Char(64)
  status         DocumentStatus @default(UPLOADING)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("documents")
}
